    "test:webkit": "playwright test --config playwright.webkit.config.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.6",
    "@fontsource/nunito-sans": "^5.2.5",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  }
}
